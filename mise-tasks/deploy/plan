#!/usr/bin/env bash
#MISE description="Read-only: what deploy:apply would run against the active profile"
set -euo pipefail
source scripts/lib.sh
load_config

# db-sync prints the profile banner first. Its stderr is teed so we can read
# the pending count; exit 3 just means "there is something to deploy".
tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
set +e
{ scripts/db-sync.sh --check --verbose 2>&1 1>&3 3>&- | tee "$tmp" >&2; rc=${PIPESTATUS[0]}; } 3>&1
set -e

case "$rc" in
  0) log "Nothing pending: profile '$DB_PROFILE' is in sync with this branch" ;;
  3) n="$(grep -oE '[0-9]+ pending migration' "$tmp" | grep -oE '^[0-9]+' | tail -1)"
     log "${n:-?} pending — apply with: mise -E $DB_PROFILE run deploy:apply" ;;
  *) die "Plan failed (db-sync exit $rc)" ;;
esac
