#!/usr/bin/env bash
#MISE description="Schema diff: tenant drift check, or live vs committed snapshots (--against)"
#USAGE flag "--against <profile>" help="Compare live global + tenant with snapshots/<profile>/"
set -euo pipefail
args=()
