# Copy to .env for local development. Never commit real credentials.
# In CI/CD the same variables come from GitHub environment vars/secrets.
#
# Topology (see README "Architecture"):
#   Global DB        sanketa_global      one database, schema `global`
#   Tenant instances sanketa_db_1, ...   N databases, one schema per school

# local  = Postgres in docker-compose (started + bootstrapped automatically)
# remote = existing servers (staging/prod); never starts or creates anything
DB_TARGET=local
POSTGRES_VERSION=18
DB_SSLMODE=disable
LOCK_TIMEOUT=5s

# Local only: docker superuser + host port for your own tools (DBeaver etc.)
POSTGRES_PASSWORD=postgres_local_only
LOCAL_PORT=5433

# ---- Global DB --------------------------------------------------------------
GLOBAL_DB_HOST=postgres
GLOBAL_DB_PORT=5432
GLOBAL_DB_NAME=sanketa_global
GLOBAL_SCHEMA=global
GLOBAL_DB_MIGRATOR_USER=sanketa_global_migrator
GLOBAL_DB_MIGRATOR_PASSWORD=global_migrator_local_only
GLOBAL_DB_APP_ROLE=sanketa_global_app
GLOBAL_DB_APP_PASSWORD=global_app_local_only

# ---- Tenant DB instances ----------------------------------------------------
# Names match database_instances.instance_name in the Global DB.
TENANT_INSTANCES=sanketa_db_1,sanketa_db_2

# Defaults shared by every instance...
TENANT_DB_HOST=postgres
TENANT_DB_PORT=5432
TENANT_DB_MIGRATOR_USER=sanketa_tenant_migrator
TENANT_DB_MIGRATOR_PASSWORD=tenant_migrator_local_only
TENANT_DB_APP_ROLE=sanketa_tenant_app
TENANT_DB_APP_PASSWORD=tenant_app_local_only

# ...overridable per instance with <INSTANCE_NAME_UPPER>_<SETTING>:
#   SANKETA_DB_2_HOST, SANKETA_DB_2_PORT, SANKETA_DB_2_NAME (default: instance name),
#   SANKETA_DB_2_SSLMODE, SANKETA_DB_2_MIGRATOR_USER, SANKETA_DB_2_MIGRATOR_PASSWORD,
#   SANKETA_DB_2_APP_ROLE
#
# Tenant schemas are discovered (tenant_*). <INSTANCE>_TENANTS are created if
# missing, so a fresh local setup has a school in each instance.
SANKETA_DB_1_TENANTS=tenant_school_001
SANKETA_DB_2_TENANTS=tenant_school_002
