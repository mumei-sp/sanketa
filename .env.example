# Copy to .env.local and tweak for your environment. Variables prefixed with
# VITE_ are exposed to the browser bundle by Vite — do NOT put secrets here.

# Base URL for the real backend API. Ignored while VITE_USE_MOCK_API=true.
VITE_API_BASE_URL=/api/v1

# HTTP client timeout in milliseconds.
VITE_API_TIMEOUT=10000

# When true (or unset), all services route through the in-memory mock adapters
# under src/mocks/. Set to 'false' to route through axios and hit the real
# backend at VITE_API_BASE_URL instead. Useful for integration testing once the
# backend is up; defaults to mocks so local dev keeps working without one.
VITE_USE_MOCK_API=true
